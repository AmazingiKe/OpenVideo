OPENVIDEO_FFMPEG_PATH=
OPENVIDEO_FFPROBE_PATH=
OPENVIDEO_TOOLS_DIRECTORY=
OPENVIDEO_CORS_ORIGINS=*
# 本地 ASR（faster-whisper）配置，模型首次使用会自动下载
OPENVIDEO_MODELS_DIRECTORY=
# 可选海外平台下载代理；国内来源仍保持直连
OPENVIDEO_DOWNLOAD_PROXY=
# 可选 LiteLLM 模型列表；通常在 Web 设置页维护
OPENVIDEO_AI_MODELS=[]
VITE_API_BASE_URL=

# 示例不包含密钥。只把需要的配置行复制到用户配置目录 OpenVideo/.env 后自行填写。
# Windows: %LOCALAPPDATA%\OpenVideo\.env
# Linux: ~/.config/OpenVideo/.env（遵循 XDG_CONFIG_HOME）
# macOS: ~/Library/Application Support/OpenVideo/.env
# 不会自动加载仓库中的 .env。启动后端时显式传入 uvicorn --env-file 文件路径。
# 已存在的进程环境变量优先，.env 不会覆盖它们。详情见 docs/deepseek-environment.md。
DEEPSEEK_API_KEY=

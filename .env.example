OPENVIDEO_FFMPEG_PATH=
OPENVIDEO_FFPROBE_PATH=
OPENVIDEO_TOOLS_DIRECTORY=
OPENVIDEO_CORS_ORIGINS=*
# 本地 ASR（faster-whisper）配置，模型首次使用会自动下载
OPENVIDEO_MODELS_DIRECTORY=
# 百炼云端 ASR 在 Web 设置页配置地域和 API Key；密钥仅保存到系统凭据库
# 可选 paraformer-v2 / fun-asr，无需本地 ASR 模型；音频上传云端并按量计费
# 可选海外平台下载代理；国内来源仍保持直连
OPENVIDEO_DOWNLOAD_PROXY=
# 可选 LiteLLM 模型列表；通常在 Web 设置页维护
OPENVIDEO_AI_MODELS=[]
VITE_API_BASE_URL=
